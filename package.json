{
  "name": "@primate-intelligence/mcp",
  "version": "0.4.0",
  "mcpName": "ai.primateintelligence/mcp",
  "description": "MCP server for the Primate Vision API (Primate Intelligence) \u2014 video scene understanding tools for AI agents.",
  "license": "MIT",
  "author": "Primate Intelligence",
  "homepage": "https://primateintelligence.ai/docs/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Primate-Intelligence/primate-intelligence-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Primate-Intelligence/primate-intelligence-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "video",
    "video-understanding",
    "vision",
    "ai",
    "agents",
    "primate-intelligence"
  ],
  "type": "module",
  "bin": {
    "primate-intelligence-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/index.js';fs.writeFileSync(p,'#!/usr/bin/env node\\n'+fs.readFileSync(p,'utf8'));fs.chmodSync(p,0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
